# Ultra-minimal Dockerfile for Kafkaesque (Production - Smallest possible)
# For production deployments without E2E tests
#
# Usage:
#   docker build -f Dockerfile.minimal -t kafkaesque-minimal .
#   docker run --rm -p 9092:9092 kafkaesque-minimal
#
#
# Note: This skips E2E tests for minimal size. Use Dockerfile.ci for testing.

# =============================================================================
# Stage 1: Build with static linking
# =============================================================================
FROM rust:1.91-alpine3.20 AS builder

RUN apk add --no-cache \
    musl-dev \
    cmake \
    make \
    g++ \
    pkgconfig \
    openssl-dev \
    openssl-libs-static

WORKDIR /app

# Set before the dependency-caching build so the pre-built deps carry the same
# fingerprint as the final build; otherwise every dependency is recompiled below.
#
# These flags MUST NOT reach proc-macro/build-script crates: a musl target with
# `crt-static` cannot produce the cdylib that a proc macro needs ("cannot produce
# proc-macro for `async-trait` as the target ... does not support these crate
# types"). Cargo only limits RUSTFLAGS to the target units when `--target` is
# passed explicitly, so every cargo invocation below passes it. The triple is
# resolved from rustc rather than hardcoded, because this image is also built
# for linux/arm64.
ENV RUSTFLAGS="-C target-feature=+crt-static -C link-arg=-static -C opt-level=z -C lto=fat -C codegen-units=1"

RUN rustc -vV | sed -n 's/^host: //p' > /rust-target && cat /rust-target

# Dependency caching
COPY Cargo.toml Cargo.lock ./
COPY crates/kafkaesque-protocol/Cargo.toml ./crates/kafkaesque-protocol/Cargo.toml
COPY crates/kafkaesque-bin/Cargo.toml ./crates/kafkaesque-bin/Cargo.toml
# The root manifest declares `[[example]] benchmark` and `[[bench]] produce_bench`;
# cargo refuses to even parse Cargo.toml unless those target files exist, so the
# dummy tree has to stub them out too (otherwise this layer silently no-ops and
# no dependencies get cached).
RUN TARGET="$(cat /rust-target)" && \
    mkdir -p src examples benches \
        crates/kafkaesque-protocol/src \
        crates/kafkaesque-bin/src && \
    echo 'fn main() {}' > src/main.rs && \
    echo 'pub fn dummy() {}' > src/lib.rs && \
    echo 'pub fn dummy() {}' > crates/kafkaesque-protocol/src/lib.rs && \
    echo 'fn main() {}' > crates/kafkaesque-bin/src/main.rs && \
    echo 'fn main() {}' > examples/benchmark.rs && \
    echo 'fn main() {}' > benches/produce_bench.rs && \
    cargo build --target "$TARGET" --release -p kafkaesque-bin --bin kafkaesque --features tls,sasl || true && \
    rm -rf src examples benches \
           crates/kafkaesque-protocol/src crates/kafkaesque-bin/src \
           "target/$TARGET/release/.fingerprint/kafkaesque-"*

# Build release binary
COPY src ./src
COPY crates ./crates
COPY examples ./examples
COPY benches ./benches

RUN TARGET="$(cat /rust-target)" && \
    cargo build --target "$TARGET" --release -p kafkaesque-bin --bin kafkaesque --features tls,sasl && \
    strip --strip-all "target/$TARGET/release/kafkaesque" && \
    cp "target/$TARGET/release/kafkaesque" /app/kafkaesque

# =============================================================================
# Stage 2: Minimal runtime (scratch + glibc compatibility)
# =============================================================================
FROM alpine:3.20

# Install only glibc compatibility (no other tools)
# This is needed only if the binary has any glibc dependencies
# For a pure static musl binary, you could use FROM scratch instead
RUN apk add --no-cache \
    ca-certificates \
    libgcc \
    && rm -rf /var/cache/apk/* /tmp/* /var/tmp/*

WORKDIR /app

# Copy only the binary
COPY --from=builder /app/kafkaesque /app/kafkaesque

# Non-root user for security
RUN adduser -D -u 1000 kafkaesque && \
    chown -R kafkaesque:kafkaesque /app
USER kafkaesque

EXPOSE 9092 9093 8080

ENTRYPOINT ["/app/kafkaesque"]
